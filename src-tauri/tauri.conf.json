{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ovim",
  "version": "0.1.0",
  "identifier": "com.tonis.ovim",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "settings",
        "title": "ovim Settings",
        "url": "/settings.html",
        "width": 820,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      },
      {
        "label": "permissions",
        "title": "Set Up ovim",
        "url": "/permissions.html",
        "width": 560,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  }
}
